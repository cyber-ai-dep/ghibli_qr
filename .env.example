DOMAIN=<your-public-domain-or-ngrok-url>
KIE_API_KEY=<your-kie-api-key>

# Stage 1 (Ghibli generation)
# flux-kontext-pro — recommended, best identity preservation
# qwen/image-edit  — legacy fallback, known identity drift
KIE_GHIBLI_MODEL=flux-kontext-pro

# Stage 2 (QR composition)
KIE_COMPOSE_MODEL=seedream/4.5-edit

# Validation
REQUIRE_HUMAN_FACE=true
MAX_FACES=1
MIN_FACE_AREA_RATIO=0.03
SHORT_CODE_LENGTH=8

# Identity drift check — enable only when using flux-kontext models
# qwen/image-edit always triggers false positives; leave false with that model
ENABLE_IDENTITY_CHECK=false

# Max concurrent MediaPipe face-detection operations
# Controls CPU ceiling on shared servers: lower = less CPU, more queue wait (~2.5s/slot)
# 5 = ~5% CPU peak | 15 = ~15% (default) | 30 = ~30%
MAX_MEDIAPIPE_CONCURRENCY=15

# Stage 1 output stability (qwen only — ignored by flux-kontext)
KIE_SEED=42
KIE_OUTPUT_FORMAT=jpeg
KIE_IMAGE_SIZE=square

# Stage 1 quality controls (qwen only)
STAGE1_GUIDANCE_SCALE=4.0
STAGE1_NUM_INFERENCE_STEPS=28
STAGE1_ACCELERATION=none
