# ============================================================================
# REQUIRED — Server identity and generation credentials
# ============================================================================

# Public/base address where this server is reachable. Used to build the returned
# image URLs (e.g. http://<host>:<port> or https://<domain>). No trailing slash.
# No webhook/ngrok needed — the BytePlus ARK generation API is synchronous.
DOMAIN=<your-public-or-server-address>

# BytePlus ARK (Seedream) API key — used for all image generation.
ARK_API_KEY=<your-ark-api-key>

# ============================================================================
# Generation (BytePlus ARK / Seedream)
# ============================================================================

# Optional ARK overrides (defaults in seedream_service.py):
# ARK_MODEL=seedream-4-5-251128
# ARK_IMAGE_SIZE=2K
# ARK_SEED=42            # fixed seed → reproducible; -1 for random
# ARK_WATERMARK=false
# ARK_API_URL=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations

# Real model per stage (sent to ARK AND reported in the response "model" field).
GHIBLI_MODEL=seedream-4-5-251128
COMPOSE_MODEL=seedream-4-5-251128

# ============================================================================
# Logging
# ============================================================================

# Root log level for all application loggers (DEBUG, INFO, WARNING, ERROR).
# Use INFO or WARNING in production; DEBUG is verbose (per-request detail).
# Note: the diagnostics log buffer only ever holds what this level lets through —
# at WARNING it will contain no INFO lines.
LOG_LEVEL=INFO

# ============================================================================
# Diagnostics API (/v1/diagnostics) — internal operational use only
# ============================================================================

# The diagnostics endpoints are ALWAYS registered and always visible in Swagger,
# so operators can discover them without a config change or restart. Access is
# controlled solely by the token below.
#
# LEAVING THIS UNSET DENIES ALL ACCESS (every request gets 401) — an absent secret
# fails closed, it never means "open to anyone". Set it to enable access.
#
# Sent by the caller as either:
#   X-Diagnostics-Token: <token>     (preferred — cannot collide with platform auth)
#   Authorization: Bearer <token>
#
# Generate with: openssl rand -hex 32   (minimum 16 chars; shorter logs a warning)
DIAGNOSTICS_TOKEN=

# Deployment environment label, reported in the diagnostics snapshot so you can
# tell prod from staging at a glance. e.g. production | staging | development
ENVIRONMENT=development

# Build identity, reported in the diagnostics snapshot. `.dockerignore` excludes
# .git/ from the image, so inside a container this env var is the ONLY source —
# set it at build time (the Dockerfile accepts it as a build ARG).
# GIT_COMMIT=

# Ring buffer sizing. Worst case memory ≈ SIZE × (MAX_MESSAGE + MAX_EXC) bytes;
# at these defaults that ceiling is ~12MB, typically ~1.5MB.
DIAG_LOG_BUFFER_SIZE=2000
# DIAG_LOG_MAX_MESSAGE_CHARS=2000
# DIAG_LOG_MAX_EXC_CHARS=4000

# URL redaction inside the buffer (stdout is never redacted):
#   off   — keep URLs verbatim
#   query — strip query strings, keep host+path (default; removes signed-URL creds)
#   full  — reduce to scheme://host/… (use when the user's imgUrl is itself PII)
DIAG_REDACT_URLS=query

# ============================================================================
# Optional — Docker host port (read by docker-compose only)
# ============================================================================

# Host-side port published by docker-compose. Container port stays 8010.
HOST_PORT=30820

# ============================================================================
# Validation rules (face detection gate)
# ============================================================================

REQUIRE_HUMAN_FACE=true
MAX_FACES=1
MIN_FACE_AREA_RATIO=0.03
SHORT_CODE_LENGTH=8

# Post-generation identity drift check.
ENABLE_IDENTITY_CHECK=false

# ============================================================================
# Concurrency & throughput
# ============================================================================

# Max concurrent CLIP classification ops (Stage 1 human-portrait gate). CLIP is
# pinned to 1 thread/call, so this IS the real core count consumed at peak.
# Default 4 assumes a dedicated host. On a shared VPS (also running a backend/DB),
# lower this to leave cores free — e.g. 2 on a 4 vCPU shared box.
CLIP_CONCURRENCY_LIMIT=4

# Max concurrent Layer-2 image downloads (fetching the user-provided imgUrl).
# I/O-bound, not CPU — an internal safety cap against an accidental burst of
# simultaneous requests, not a public rate limit.
DOWNLOAD_CONCURRENCY_LIMIT=24

# Max concurrent generation submissions to ARK. Official BytePlus limit is
# 500 IPM/RPM (throughput, not a connection cap) — see
# docs.byteplus.com/en/docs/ModelArk/1824718. I/O-bound like downloads, so it
# can run well above CLIP_CONCURRENCY_LIMIT even on a CPU-constrained host.
# 24 is measured-safe (cuts avg pipeline time ~58% vs the old default of 8,
# with zero 429s) — see config.py comment for the load-test numbers.
GENERATION_CONCURRENCY_LIMIT=24

# ============================================================================
# Local image saving
# ============================================================================

# When true, every final image is ALSO saved on this machine under OUTPUT_DIR
# (in addition to the served /tmp URL returned by the API).
SAVE_OUTPUT_LOCAL=false
OUTPUT_DIR=output

# ============================================================================
# Generated file retention (cleanup runs every 30 minutes)
# ============================================================================

STAGE1_TTL_HOURS=2
QRLOCK_TTL_HOURS=2
FINAL_IMAGE_TTL_HOURS=24
PERSIST_FINAL_IMAGES=false
