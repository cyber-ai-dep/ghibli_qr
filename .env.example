# ============================================================================
# REQUIRED — Server identity and KIE credentials
# ============================================================================

# Public URL where this server is reachable. KIE webhooks post to:
#   {DOMAIN}/v1/ghibli/callback
# No trailing slash. Use http:// only for non-public testing.
DOMAIN=<your-public-domain-or-ngrok-url>

KIE_API_KEY=<your-kie-api-key>

# ============================================================================
# REQUIRED — Generation models
# ============================================================================

# Stage 1 (portrait → Ghibli style)
#   flux-kontext-pro — recommended, best identity preservation
#   qwen/image-edit  — legacy fallback, known identity drift
KIE_GHIBLI_MODEL=flux-kontext-pro

# Stage 2 (Ghibli + QR composition)
KIE_COMPOSE_MODEL=seedream/4.5-edit

# Legacy single-model fallback. Used only if KIE_GHIBLI_MODEL or
# KIE_COMPOSE_MODEL above are unset. Leave commented in new deployments.
# KIE_IMG_MODEL=

# ============================================================================
# Optional — Docker host port (read by docker-compose only)
# ============================================================================

# Host-side port published by docker-compose. Container port stays 8010.
# Example: HOST_PORT=8090 → reachable at http://<host>:8090
HOST_PORT=30820

# ============================================================================
# Validation rules (face detection gate)
# ============================================================================

REQUIRE_HUMAN_FACE=true
MAX_FACES=1
MIN_FACE_AREA_RATIO=0.03
SHORT_CODE_LENGTH=8

# Post-generation identity drift check.
# Enable only when using flux-kontext models — qwen/image-edit triggers
# false positives consistently with Ghibli prompts.
ENABLE_IDENTITY_CHECK=false

# ============================================================================
# Concurrency & throughput
# ============================================================================

# Max simultaneous MediaPipe face-detection operations.
# Lower = less CPU peak, more queue wait (~2.5s/slot).
# 5 = ~5% CPU peak | 15 = ~15% (default) | 30 = ~30%
MAX_MEDIAPIPE_CONCURRENCY=15

# ============================================================================
# Generated file retention (cleanup runs every 30 minutes)
# ============================================================================

# Stage 1 re-hosted output (intermediate; not returned to client).
STAGE1_TTL_HOURS=2

# QR lock image used as Stage 2 input (intermediate).
QRLOCK_TTL_HOURS=2

# Final composed image returned to the client. Most consumers
# fetch it within minutes; 24h covers retries and short-term reuse.
FINAL_IMAGE_TTL_HOURS=24

# Set to true to keep final_ images forever (cleanup skips them).
# Use with caution — disk usage grows unbounded.
PERSIST_FINAL_IMAGES=false

# ============================================================================
# Stage 1 quality controls (qwen only — ignored by flux-kontext)
# ============================================================================

STAGE1_GUIDANCE_SCALE=4.0
STAGE1_NUM_INFERENCE_STEPS=28
STAGE1_ACCELERATION=none

# ============================================================================
# Stage 1 output stability (qwen only — ignored by flux-kontext)
# ============================================================================

KIE_SEED=42
KIE_OUTPUT_FORMAT=jpeg
KIE_IMAGE_SIZE=square
