# ============================================================================
# REQUIRED — Server identity and generation credentials
# ============================================================================

# Public/base address where this server is reachable. Used to build the returned
# image URLs (e.g. http://<host>:<port> or https://<domain>). No trailing slash.
# No webhook/ngrok needed — the BytePlus ARK generation API is synchronous.
DOMAIN=<your-public-or-server-address>

# By default the URLs this API returns (resultUrls / stage1Url / qrUrl) are built
# from each request's own Host / X-Forwarded-* headers, not from DOMAIN. That is
# what lets one deployment answer correctly whether it is reached at
# https://api.example.com through a proxy, or directly at http://<ip>:30820 —
# each caller gets links on the address it actually used. DOMAIN above is the
# fallback for requests with no usable Host.
# Set this to false to pin every returned URL to DOMAIN instead.
PUBLIC_URL_FROM_REQUEST=true

# Optional hardening: comma-separated hostnames (no port) accepted from the
# Host / X-Forwarded-Host header, e.g. "api.example.com,10.0.0.5". A host outside
# the list falls back to DOMAIN. Host is client-controlled, so this bounds which
# hostnames can appear in returned links. Empty accepts the host the request
# arrived on — which is what makes domain and IP both work with no setup.
TRUSTED_HOSTS=

# Which peers uvicorn accepts X-Forwarded-* headers from. Its own default is
# 127.0.0.1, so behind any reverse proxy / ingress / load balancer (which
# connects from a different address) uvicorn DISCARDS X-Forwarded-Proto and
# believes an HTTPS request arrived over plain http. Returned image URLs stay
# correct either way (the app reads the header itself), but Starlette's
# trailing-slash redirects emit an http:// Location, which browsers block as
# mixed content. Narrow "*" to the proxy's address once TLS is in front.
FORWARDED_ALLOW_IPS=*

# BytePlus ARK (Seedream) API key — used for all image generation.
ARK_API_KEY=<your-ark-api-key>

# ============================================================================
# Generation (BytePlus ARK / Seedream)
# ============================================================================
# Optional ARK overrides (defaults in seedream_service.py):
# ARK_MODEL=seedream-4-5-251128
# ARK_IMAGE_SIZE=2K
# ARK_SEED=42            # fixed seed → reproducible; -1 for random
# ARK_WATERMARK=false
# ARK_API_URL=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations

# Real model per stage (sent to ARK AND reported in the response "model" field).
#
# [REVIEW] The two stages deliberately run DIFFERENT models. This mirrors what is
# deployed and producing correct output. Stage 1 is the identity/skin-tone step
# and is the part most sensitive to a model change, so moving it to 4.5 is not a
# version bump — re-check output quality afterwards.
GHIBLI_MODEL=seedream-4-0-250828
COMPOSE_MODEL=seedream-4-5-251128

# ============================================================================
# Logging
# ============================================================================

# Root log level for all application loggers (DEBUG, INFO, WARNING, ERROR).
# Use INFO or WARNING in production; DEBUG is verbose (per-request detail).
# Note: the diagnostics log buffer only ever holds what this level lets through —
# at WARNING it will contain no INFO lines.
LOG_LEVEL=INFO

# ============================================================================
# Diagnostics API (/v1/diagnostics) — internal operational use only
# ============================================================================

# The diagnostics endpoints are ALWAYS registered and always visible in Swagger,
# so operators can discover them without a config change or restart. Access is
# controlled solely by the token below.
#
# LEAVING THIS UNSET DENIES ALL ACCESS (every request gets 401) — an absent secret
# fails closed, it never means "open to anyone". Set it to enable access.
#
# Sent by the caller as either:
#   X-Diagnostics-Token: <token>     (preferred — cannot collide with platform auth)
#   Authorization: Bearer <token>
#
# Generate with: openssl rand -hex 32   (minimum 16 chars; shorter logs a warning)
DIAGNOSTICS_TOKEN=

# Deployment environment label, reported in the diagnostics snapshot so you can
# tell prod from staging at a glance. e.g. production | staging | development
ENVIRONMENT=development

# Build identity, reported in the diagnostics snapshot. `.dockerignore` excludes
# .git/ from the image, so inside a container this env var is the ONLY source —
# set it at build time (the Dockerfile accepts it as a build ARG).
# GIT_COMMIT=

# Ring buffer sizing. Worst case memory ≈ SIZE × (MAX_MESSAGE + MAX_EXC) bytes;
# at these defaults that ceiling is ~12MB, typically ~1.5MB.
DIAG_LOG_BUFFER_SIZE=2000
# DIAG_LOG_MAX_MESSAGE_CHARS=2000
# DIAG_LOG_MAX_EXC_CHARS=4000

# URL redaction inside the buffer (stdout is never redacted):
#   off   — keep URLs verbatim
#   query — strip query strings, keep host+path (default; removes signed-URL creds)
#   full  — reduce to scheme://host/… (use when the user's imgUrl is itself PII)
DIAG_REDACT_URLS=query

# ============================================================================
# Optional — Docker host port (read by docker-compose only)
# Optional — Docker host settings (read by docker-compose only)
# ============================================================================

# Host-side port published by docker-compose. Container port stays 8010.
HOST_PORT=30820

# Which host interface that port binds to. This is the private/public switch
# under Docker Compose, and it has no application-side equivalent:
#   0.0.0.0    = reachable from outside the host
#   127.0.0.1  = this host only. Other containers still reach it as
#                http://ghibli-api:8010 by joining the `ghibli-net` network.
# There is no authentication on any route except /v1/diagnostics, and generation
# calls are billed per request, so 0.0.0.0 must be paired with firewall or
# security-group rules limiting who can reach the port.
# Under Kubernetes this key does nothing — use a ClusterIP Service with no
# Ingress to keep the service internal.
BIND_ADDRESS=0.0.0.0

# Container memory ceiling. 4g is confirmed-safe headroom above the ~1GB CLIP
# baseline for a real concurrent burst (tested: 40 simultaneous requests) — a
# 2g ceiling was proven too tight and got the process OOM-killed under load.
# Raise further only if you also raise CLIP_CONCURRENCY_LIMIT /
# DOWNLOAD_CONCURRENCY_LIMIT well beyond their current values.
MEM_LIMIT=4g

# ============================================================================
# Validation rules
# ============================================================================

# Reject requests whose image doesn't classify as a single real human portrait
# (CLIP zero-shot check — see clip_validation_service.py). Set false to bypass
# Stage 1 validation entirely (no CLIP call at all).
REQUIRE_HUMAN_FACE=true
SHORT_CODE_LENGTH=8

# Post-generation identity drift check.
ENABLE_IDENTITY_CHECK=false

# ============================================================================
# Access control (optional — default fully open, matches no-auth today)
# ============================================================================

# When true, every route except /v1/health rejects callers whose IP isn't in
# ALLOWED_IPS with 403. Independent of any VPS firewall — a pure config
# toggle, no code change or restart-only-that-one-service needed beyond a
# normal `docker compose up -d`. Leave false for the default fully-open mode.
PRIVATE_MODE=false
# Comma-separated IPs, only read when PRIVATE_MODE=true. Leave empty + set
# PRIVATE_MODE=true to fail-closed (blocks everyone except /v1/health) —
# a startup warning is logged if this combination is detected.
ALLOWED_IPS=

# ============================================================================
# Rate limiting (safety net against runaway ARK cost)
# ============================================================================

# Caps requests to /v1/ghibli and /v1/ghibli-qr over time — different from
# the concurrency limits below, which only cap simultaneous in-flight
# requests. Enabled by default: 60 req/60s comfortably exceeds this service's
# real sustained throughput (~30 req/min at full GENERATION_CONCURRENCY_LIMIT
# capacity) while still catching a genuine runaway (bug, retry loop).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Concurrency & throughput
# ============================================================================

# Max concurrent CLIP classification ops (Stage 1 human-portrait gate). CLIP is
# pinned to 1 thread/call, so this IS the real core count consumed at peak.
# Default 4 assumes a dedicated host. On a shared VPS (also running a backend/DB),
# lower this to leave cores free — e.g. 2 on a 4 vCPU shared box.
CLIP_CONCURRENCY_LIMIT=4

# Max concurrent Layer-2 image downloads (fetching the user-provided imgUrl).
# I/O-bound, not CPU — an internal safety cap against an accidental burst of
# simultaneous requests, not a public rate limit.
DOWNLOAD_CONCURRENCY_LIMIT=24

# Max concurrent generation submissions to ARK. Official BytePlus limit is
# 500 IPM/RPM (throughput, not a connection cap) — see
# docs.byteplus.com/en/docs/ModelArk/1824718. I/O-bound like downloads, so it
# can run well above CLIP_CONCURRENCY_LIMIT even on a CPU-constrained host.
# 24 is measured-safe (cuts avg pipeline time ~58% vs the old default of 8,
# with zero 429s) — see config.py comment for the load-test numbers.
GENERATION_CONCURRENCY_LIMIT=24

# ============================================================================
# Local image saving
# ============================================================================

# When true, every final image is ALSO saved on this machine under OUTPUT_DIR
# (in addition to the served /tmp URL returned by the API).
SAVE_OUTPUT_LOCAL=false
OUTPUT_DIR=output

# ============================================================================
# Generated file retention (cleanup runs every 30 minutes)
# ============================================================================

# Intermediate files only (stage1_ portrait, qrlock_ QR graphic) — safe to
# keep short since nothing external depends on these surviving long-term.
STAGE1_TTL_HOURS=2
QRLOCK_TTL_HOURS=2

# final_ = the Stage 2 Ghibli+QR composite returned to the client. TTL below
# is IGNORED while PERSIST_FINAL_IMAGES=true — these must never be silently
# deleted, so persistence is the default. Set PERSIST_FINAL_IMAGES=false only
# if you have an external store (e.g. object storage) taking over delivery.
FINAL_IMAGE_TTL_HOURS=24
PERSIST_FINAL_IMAGES=true
