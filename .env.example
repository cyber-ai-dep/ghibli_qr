DOMAIN=<your-domain-url>
KIE_API_KEY=<your-kie-api-token>
# Preferred: split models per pipeline stage
# Stage 1 (Ghibli generation): Qwen image edit
KIE_GHIBLI_MODEL=qwen/image-edit
# Stage 2 (Composition): Seedream image edit
KIE_COMPOSE_MODEL=seedream/4.5-edit

# Backward compatible (optional): single model for both stages
# KIE_IMG_MODEL=seedream/4.5-edit

# Validation settings
REQUIRE_HUMAN_FACE=true
MAX_FACES=1
MIN_FACE_AREA_RATIO=0.03

SHORT_CODE_LENGTH=8